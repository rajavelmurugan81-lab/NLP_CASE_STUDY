# ==============================================================
# Environment Configuration Template
# Copy this file to .env and customize for local development:
#   copy .env.example .env
# ==============================================================

# Flask Server Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=college_nlp_project_secret_key_change_in_production

# Database Settings
DATABASE_PATH=database/literature_review.db

# LLM & External Academic API Keys (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
# External Academic API Keys (OpenAlex works without a key; add if available)
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# RAG Knowledge Base & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_PATH=vector_data/faiss_index.bin
VECTOR_METADATA_PATH=vector_data/chunk_metadata.json
MAX_CONTENT_LENGTH=26214400


